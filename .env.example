# ================================================================
# PrivAgent - AI Model Configuration (.env.example)
# Multi-provider rotation: OpenRouter → Groq → HuggingFace
# ================================================================

# ----------------------------------------------------------------
# Provider 1: OpenRouter (primary VLM + reasoning)
# ----------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VLM_OPENROUTER_MODEL=google/gemma-4-31b-it:free

# ----------------------------------------------------------------
# Provider 2: Groq (fast inference fallback)
# ----------------------------------------------------------------
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AI_BASE_URL=https://api.groq.com/openai/v1
REASONING_MODEL=groq/compound-mini
REASONING_MAX_TOKENS=600
VLM_GROQ_MODEL=qwen/qwen3.6-27b
# ----------------------------------------------------------------
# Provider 3: HuggingFace (additional fallback)
# ----------------------------------------------------------------
# HUGGINGFACE_API_KEY=hf_xxxxxxxxxxxxxxxxxxxxxxxx
# VLM_HUGGINGFACE_MODEL=Qwen/Qwen2.5-VL-72B-Instruct

# ----------------------------------------------------------------
# Provider Rotation & Timeout Settings
# ----------------------------------------------------------------
VLM_PROVIDER_ORDER=openrouter,groq,huggingface
VLM_MAX_ATTEMPTS=3
VLM_REQUEST_TIMEOUT_SECONDS=15
REASONING_REQUEST_TIMEOUT_SECONDS=15
INTERPRETATION_REQUEST_TIMEOUT_SECONDS=10

# ----------------------------------------------------------------
# Default Model Configuration
# ----------------------------------------------------------------
AI_BASE_URL=https://openrouter.ai/api/v1
VLM_MODEL=google/gemma-4-31b-it:free
REASONING_MODEL=openai/gpt-oss-120b

# ----------------------------------------------------------------
# Server Settings
# ----------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
