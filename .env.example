# ================================================================
# PrivAgent - AI Model Configuration (.env.example)
# Keep this file free of real credentials.
# ================================================================

# ----------------------------------------------------------------
# VLM credentials rotate in this order. You can put multiple
# comma-separated keys in each *_API_KEYS variable.
# ----------------------------------------------------------------
# OPENROUTER_API_KEYS=sk-or-v1-key-a,sk-or-v1-key-b
# HUGGINGFACE_API_KEYS=hf-token-a,hf-token-b
# GROQ_API_KEYS=gsk-key-a,gsk-key-b

# ----------------------------------------------------------------
# VLM model IDs (must accept image input at each provider).
# A provider-specific value falls back to VLM_MODEL when omitted.
# ----------------------------------------------------------------
# VLM_MODEL=provider/model-id
# VLM_OPENROUTER_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
# VLM_HUGGINGFACE_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
# VLM_GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# ----------------------------------------------------------------
# VLM provider rotation & timeout settings
# ----------------------------------------------------------------
VLM_PROVIDER_ORDER=openrouter,huggingface,groq
VLM_MAX_ATTEMPTS=2
VLM_REQUEST_TIMEOUT_SECONDS=4

# ----------------------------------------------------------------
# Reasoning engine (stays on the AI_BASE_URL / AI_API_KEY selection).
# REASONING_MODEL must be a reasoning-capable model on that endpoint.
# ----------------------------------------------------------------
AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=reasoning-provider-key
REASONING_MODEL=openai/gpt-oss-120b
REASONING_REQUEST_TIMEOUT_SECONDS=12
INTERPRETATION_REQUEST_TIMEOUT_SECONDS=10

# ----------------------------------------------------------------
# Server settings (bind localhost for a local prototype)
# ----------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
