# ================================================================
# PrivAgent - AI Model Configuration (.env.example)
# Keep this file free of real credentials.
# ================================================================

# ----------------------------------------------------------------
# VLM credentials rotate in this order. You can put multiple
# comma-separated keys in each *_API_KEYS variable.
# ----------------------------------------------------------------
# OPENROUTER_API_KEYS=sk-or-v1-key-a,sk-or-v1-key-b
# HUGGINGFACE_API_KEYS=hf-token-a,hf-token-b
# GROQ_API_KEYS=gsk-key-a,gsk-key-b
#
# NEVER commit a real key. .env is gitignored, CI reads keys from repository
# secrets, and `npm run build:extensions` fails if a provider key pattern is
# found in a packaged file. If a key is ever committed, rotate it at the
# provider — gitignoring a file only protects future commits.

# ----------------------------------------------------------------
# VLM model IDs (must accept image input at each provider).
# A provider-specific value falls back to VLM_MODEL when omitted.
# ----------------------------------------------------------------
# VLM_MODEL=provider/model-id
# VLM_OPENROUTER_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
# VLM_HUGGINGFACE_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
# VLM_GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# ----------------------------------------------------------------
# VLM provider rotation & timeout settings
# ----------------------------------------------------------------
VLM_PROVIDER_ORDER=openrouter,huggingface,groq
VLM_MAX_ATTEMPTS=2
VLM_REQUEST_TIMEOUT_SECONDS=4

# ----------------------------------------------------------------
# Reasoning engine (stays on the AI_BASE_URL / AI_API_KEY selection).
# REASONING_MODEL must be a reasoning-capable model on that endpoint.
# Planner + Critique share this model and timeout in one fused /reason call per step.
# ----------------------------------------------------------------
AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=reasoning-provider-key
REASONING_MODEL=openai/gpt-oss-120b
REASONING_REQUEST_TIMEOUT_SECONDS=12
INTERPRETATION_REQUEST_TIMEOUT_SECONDS=10

# Amazon Bedrock alternative (uncomment/configure these instead of the values above).
# Use a Bedrock API key, not an AWS access-key ID/secret pair.
# AI_BASE_URL=https://bedrock-runtime.us-east-1.amazonaws.com/openai/v1
# AWS_BEARER_TOKEN_BEDROCK=<your Bedrock API key>
# BEDROCK_REGION=us-east-1
# REASONING_MODEL=openai.gpt-oss-120b-1:0

# ----------------------------------------------------------------
# Server settings
# ----------------------------------------------------------------
# Bind loopback. 0.0.0.0 exposes an unauthenticated-by-origin model proxy to
# every interface, and the origin check only proves the caller looks like an
# extension — any local process can spoof that header.
HOST=127.0.0.1
PORT=8000

# ----------------------------------------------------------------
# Logging
# ----------------------------------------------------------------
# Level for the console sink. The JSONL file always receives DEBUG and above,
# so raising this to DEBUG is only needed to see debug detail on the console.
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Set to false to log to the console only. The rotating file is what you attach
# to a bug report.
LOG_TO_FILE=true
# Directory for backend.jsonl and its rotations. Defaults to backend/logs,
# resolved relative to the server, not the working directory.
# LOG_DIR=backend/logs
# LOG_FILE=backend.jsonl
# Rotation: 8 MiB per file, 5 kept (backend.jsonl.1 ... backend.jsonl.5).
# LOG_MAX_BYTES=8388608
# LOG_BACKUP_COUNT=5

# Required by /vision, /reason, and /interpret. Generate a random value with:
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Copy the resulting value into the extension's Backend access token setting.
BACKEND_SHARED_SECRET=replace-with-a-random-32-byte-or-longer-secret
# Optional exact extension-origin allowlist, comma separated. Example:
# EXTENSION_ORIGINS=chrome-extension://<your-extension-id>
EXTENSION_ORIGINS=
