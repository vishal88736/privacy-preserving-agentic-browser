# VLM credentials rotate in this order. You can put multiple comma-separated
# keys in each *_API_KEYS variable; keep this file free of real credentials.
# OPENROUTER_API_KEYS=key-a,key-b
# HUGGINGFACE_API_KEYS=hf-token-a,hf-token-b
# GROQ_API_KEYS=gsk-key-a,gsk-key-b
VLM_PROVIDER_ORDER=openrouter,huggingface,groq
VLM_MAX_ATTEMPTS=2
VLM_REQUEST_TIMEOUT_SECONDS=4

# Set model IDs that accept image input at each provider. A provider-specific
# value falls back to VLM_MODEL when omitted.
# VLM_MODEL=provider/model-id
# VLM_OPENROUTER_MODEL=provider/model-id
# VLM_HUGGINGFACE_MODEL=provider/model-id
# VLM_GROQ_MODEL=provider/model-id

# Reasoning stays on the configured AI_BASE_URL / AI_API_KEY selection.
AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=reasoning-provider-key
# REASONING_MODEL=provider/reasoning-model-id
REASONING_REQUEST_TIMEOUT_SECONDS=12
HOST=127.0.0.1
PORT=8000
