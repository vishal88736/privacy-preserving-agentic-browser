{
  "manifest_version": 3,
  "name": "Privacy-Preserving Agentic Browser (SIH)",
  "version": "1.0.0",
  "description": "Browser agent with local OCR and object detection, client-side visual PII masking, and VLM reasoning over sanitized screenshots.",
  "permissions": ["tabs", "scripting", "storage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["background/service-worker.js"],
    "type": "module"
  },
  "sidebar_action": {
    "default_title": "Privacy Agent",
    "default_panel": "sidepanel/index.html",
    "default_icon": "icons/icon48.png"
  },
  "action": { "default_title": "Open Privacy Agent Sidebar" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "privacy-agent@local.sih",
      "strict_min_version": "121.0",
      "data_collection_permissions": { "required": ["websiteContent"] }
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
