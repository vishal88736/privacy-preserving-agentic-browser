{
  "name": "privacy-preserving-agentic-browser",
  "version": "1.0.0",
  "description": "Privacy-Preserving Agentic Browser Extension - Unit & Integration Tests",
  "type": "module",
  "scripts": {
    "test": "node --test tests/**/*.test.js extension/perception/task-grounding.test.js",
    "test:privacy": "node --test tests/privacy/*.test.js",
    "test:executor": "node --test tests/executor/*.test.js",
    "test:reasoning": "node --test tests/reasoning/*.test.js",
    "test:navigation": "node --test tests/navigation/*.test.js",
    "test:perception": "node --test tests/perception/*.test.js extension/perception/task-grounding.test.js",
    "test:agent": "node --test tests/agent/*.test.js",
    "test:schemas": "node --test tests/shared/*.test.js",
    "test:all": "node --test 'tests/**/*.test.js' 'extension/perception/task-grounding.test.js'"
  },
  "keywords": ["browser-extension", "privacy", "agentic", "testing"],
  "license": "ISC"
}
